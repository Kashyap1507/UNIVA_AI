# Test Environment Configuration
FLASK_ENV=testing
DEBUG=False

# Security Keys (test-only)
SECRET_KEY=test-secret-key-for-ci-testing-only
JWT_SECRET_KEY=test-jwt-secret-for-ci-testing-only

# Redis (optional for tests)
REDIS_URL=redis://localhost:6379

# Firebase (skip initialization in tests)
SKIP_FIREBASE_INIT=true

# Gemini AI (mock in tests)
GOOGLE_GEMINI_API_KEY=REPLACE_WITH_NEW_GEMINI_KEY

# SendGrid (mock in tests)
SENDGRID_API_KEY=test-sendgrid-key

# Testing flags
TESTING=true
