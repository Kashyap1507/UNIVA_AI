# ============================================
# WhizKids Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env or firebase-service-account.json to git

# ============================================
# Flask Configuration
# ============================================
FLASK_ENV=development
PORT=5000
LOG_LEVEL=INFO

# ============================================
# Security Keys
# ============================================
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# These keys MUST be changed in production!
# The application will FAIL to start if these are not set properly.
#
# Generate cryptographically secure random keys using:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# OR use this one-liner to generate both:
# python -c "import secrets; print(f'SECRET_KEY={secrets.token_urlsafe(32)}'); print(f'JWT_SECRET_KEY={secrets.token_urlsafe(32)}')"
#
# ⚠️ NEVER use these example values in production!
# ⚠️ NEVER commit actual secrets to git!
# ⚠️ In production, these MUST be set via environment variables or secure secret management
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# ============================================
# Firebase Configuration
# ============================================
# ⚠️ SECURITY: NEVER commit firebase-service-account.json to git!
# Add it to .gitignore to prevent accidental commits
# Path to Firebase service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Firebase Realtime Database URL (if using)
# Format: https://your-project-id.firebaseio.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ============================================
# Email Configuration (SendGrid)
# ============================================
# ⚠️ SECURITY: Treat API keys as sensitive credentials
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Rotate this key if accidentally exposed
SENDGRID_API_KEY=your-sendgrid-api-key

# Email sender address (must be verified in SendGrid)
FROM_EMAIL=noreply@whizkids.app

# ============================================
# AI Services
# ============================================
# ⚠️ SECURITY: API keys provide access to paid services - keep confidential
# Required for homework correction and worksheet generation
# Get API key from: https://aistudio.google.com/app/apikey
# Monitor usage to detect unauthorized access
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# ============================================
# LLM Orchestration Framework (v2.0.0)
# ============================================
# LangGraph + Instructor workflows
# Default: true (enabled for development)
# Set to 'false' in production if you want to use legacy workflows
USE_LANGGRAPH_CORRECTION=true
USE_LANGGRAPH_WORKSHEET=true
USE_LANGGRAPH_QUIZ=true
USE_LANGGRAPH_CALENDAR=true

# Optional: LangSmith for advanced observability
# Get API key from: https://smith.langchain.com/
# Provides tracing for:
#   - LangGraph workflows (homework correction, worksheet generation)
#   - RAG textbook retrieval (embedding generation, vector search)
#   - Gemini API calls and prompt engineering
# View traces at: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=wizly-ai-workflows
LANGSMITH_TRACING_V2=true

# LangSmith privacy settings (optional)
# Hide large inputs (base64 images) to avoid payload size limits
# LANGCHAIN_HIDE_INPUTS=true
# LANGCHAIN_HIDE_OUTPUTS=false

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins (or '*' for all)
CORS_ORIGINS=http://localhost:3000,https://whizkids.app,https://www.whizkids.app

# ============================================
# Cache Configuration
# ============================================
# Cache type: simple (memory) or redis
CACHE_TYPE=simple

# Redis URL (only needed if CACHE_TYPE=redis)
REDIS_URL=redis://localhost:6379/0
# Alternative: CACHE_REDIS_URL=redis://localhost:6379/0

# Cache timeout in seconds (default: 3600 = 1 hour)
CACHE_DEFAULT_TIMEOUT=3600

# ============================================
# Rate Limiting
# ============================================
# Set to 'true' to disable rate limiting in testing mode
DISABLE_RATE_LIMITING=false

# ============================================
# Optional: Google Cloud Storage
# ============================================
# Bucket name for uploads (if using GCS)
# GCS_BUCKET_NAME=whizkids-uploads

# ============================================
# Analytics & Error Reporting
# ============================================
# Sentry DSN for error tracking and performance monitoring
# Get from: https://sentry.io/settings/projects/your-project/keys/
SENTRY_DSN=your-sentry-dsn-here

# Google Cloud Project ID (for Error Reporting)
# Will use FIREBASE_PROJECT_ID if not set
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Sentry Environment (development, staging, production)
# Auto-detected from FLASK_ENV if not set
# SENTRY_ENVIRONMENT=development

# ============================================
# Development/Testing Flags
# ============================================
# Set to 'true' to enable debug mode features
# DEBUG=false
