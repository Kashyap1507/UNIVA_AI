.navigation/

# Android Studio captures folder
captures/

# IntelliJ
out/
.idea_modules/

# Misc
*.swp
*~
.DS_Store

# ============================================
# iOS / Xcode
# ============================================
# CocoaPods
iosApp/Pods/
Pods/

# We DO track Podfile.lock for reproducible builds
# Podfile.lock

# Xcode
iosApp/build/
iosApp/.build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xcworkspace
!default.xcworkspace
