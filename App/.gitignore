xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Swift Package Manager
.build/
.swiftpm/

# Carthage
Carthage/Build

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/

# Xcode DerivedData
DerivedData/

# ============================================
# macOS
# ============================================
.DS_Store
.AppleDouble
.LSOverride
._*

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ============================================
# Windows
# ============================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# ============================================
# Kotlin/Native
# ============================================
*.klib
*.knm
kotlin-native-dependencies/

# ============================================
# Logs
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Environment Variables
# ============================================
.env
.env.local
.env.*.local

# ============================================
# SECURITY: Keystore & Credentials Files
# NEVER commit production keystores or credentials!
# ============================================
*.keystore
*.jks
*.p12
*.key
release.keystore
debug.keystore
keystore.properties
key.properties

# OAuth credentials (local.properties pattern)
local.properties

# iOS Keychain exports
*.keychain
*.keychain-db

# ============================================
# Provisioning Profiles
# ============================================
*.mobileprovision
*.provisionprofile

# ============================================
# Firebase & OAuth Credentials
# ============================================
# SECURITY WARNING: Firebase config files contain API keys
# Consider excluding in production or using environment-specific configs
# google-services.json
# GoogleService-Info.plist

# OAuth client secrets (should be injected at build time)
**/oauth-credentials.json
**/client-secret*.json

# ============================================
# Generated files
# ============================================
# Android generated
androidApp/src/main/java/**/R.java
androidApp/src/main/java/**/BuildConfig.java

# iOS generated
iosApp/iosApp/GoogleService-Info-Generated.plist

# ============================================
# Testing
# ============================================
.testlog
test-results/
junit-reports/

# ============================================
# Documentation Build
# ============================================
docs/_build/
site/

# ============================================
# Backup files
# ============================================
*.bak
*.gho
*.ori
*.orig
*.tmp

# ============================================
# Kotlin Multiplatform Specifics
# ============================================
.kotlin/
shared/build/
androidApp/build/
iosApp/build/
composeApp/build/
