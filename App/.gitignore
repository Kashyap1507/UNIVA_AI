build/
*/build/
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar
captures/
.externalNativeBuild
.cxx
local.properties

# Gradle cache
.gradle
gradle-app.setting

# Android build outputs
*.apk
*.aab
*.ap_
*.dex
*.class

